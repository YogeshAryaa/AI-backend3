# ======================= Required =======================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ragapp
ADMIN_TOKEN=change-me-to-a-long-random-string
APP_SECRET_KEY=change-me-to-another-long-random-string

# ======================= Security =======================
CORS_ORIGINS=*
DOCS_ENABLED=true
MAX_UPLOAD_MB=25
DEFAULT_KEY_RPM=120

# ======================= Embeddings (Gemini Cloud API - 0 MB RAM) =======================
# gemini (uses 0 MB RAM, free API) | openai | torch
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=text-embedding-004
# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ======================= Vector search =======================
VECTOR_BACKEND=local
VECTOR_INDEX_NAME=vector_index
VECTOR_DTYPE=float16

# ======================= Answering defaults =======================
MIN_SCORE_MODE=auto
MIN_SCORE=0.5
TOP_K=5
CACHE_ENABLED=true
CACHE_THRESHOLD=0.97
CACHE_TTL_DAYS=14
SEND_CONTEXT_TO_EXTERNAL=true
MAX_CONTEXT_CHARS=6000
QUERY_REWRITE=true
HISTORY_DAYS=0

CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# ======================= MongoDB auto-sync =======================
AUTO_SYNC_COLLECTIONS=*
AUTO_SYNC_MINUTES=1
SYNC_MAX_RECORDS=0
